{
    "name": "luthemes/ecclesiastical",
    "description": "Ecclesiastical is a starter theme for ClassicPress, built on the Backdrop framework.",
    "type": "wordpress-theme",
    "keywords": [
        "classicpress",
        "classicpress-theme",
        "wordpress-theme"
    ],
    "homepage": "https://github.com/luthemes/ecclesiastical",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Benjamin Lu",
            "email": "benlumia007@gmail.com",
            "homepage": "https://luthemes.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Ecclesiastical\\": "app/"
        },
        "files": [
            "app/framework.php",
            "app/functions-comments.php",
            "app/functions-display.php",
            "app/functions-filters.php",
            "app/functions-scripts.php",
            "app/functions-setup.php"
        ]
    },
    "require": {
        "php": ">=7.4",
        "backdrop-dev/framework": "^1.0"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4"
        }
    }
}
